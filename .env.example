# ========== 应用配置 ==========
APP_NAME=TeacherManagementSystem
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=teacher_system

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Milvus ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=teacher_knowledge

# ========== DeepSeek API ==========
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# ========== Embedding API (DashScope) ==========
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-v3

# ========== JWT ==========
JWT_SECRET_KEY=your_jwt_secret_key
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== AES 加密 ==========
AES_ENCRYPTION_KEY=your_32_byte_aes_key_here_!!!!

# ========== 文件上传 ==========
UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE=2097152
MAX_ATTACHMENT_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif
ALLOWED_DOC_TYPES=pdf,doc,docx,xls,xlsx

# ========== 考勤规则 ==========
CHECK_IN_START=08:00
CHECK_IN_END=09:00
CHECK_OUT_START=17:00
CHECK_OUT_END=18:00

# ========== Agent ==========
AGENT_SESSION_TTL=86400
AGENT_MAX_HISTORY=20
